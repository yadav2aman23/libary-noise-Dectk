// =====================================================
// LOOP
// =====================================================

void loop()
{
  // ===================================================
  // Firebase background processing
  // ===================================================

  app.loop();

  // ===================================================
  // WIFI
  // ===================================================

  checkWiFi();

  // ===================================================
  // READ NOISE
  // ===================================================

  float noise =
    readNoiseLevel();

  // ===================================================
  // STATUS
  // ===================================================

  String status =
    getStatus(
      noise
    );

  // ===================================================
  // NOISY CONDITION
  // ===================================================

  bool isNoisy =
    noise >= NOISE_LIMIT;

  // ===================================================
  // VIOLATION
  // ===================================================

  bool violation = false;

  // Count only when noise starts
  if (
    isNoisy &&
    !previousNoisy
  )
  {
    violationCount++;

    violation = true;

    Serial.println();

    Serial.println(
      "!!! NEW NOISE VIOLATION !!!"
    );
  }

  // Save current state
  previousNoisy =
    isNoisy;

  // ===================================================
  // SERIAL MONITOR
  // ===================================================

  Serial.println();

  Serial.println(
    "--------------------------------------"
  );

  Serial.print(
    "Table Number : "
  );

  Serial.println(
    TABLE_NUMBER
  );

  Serial.print(
    "Noise Level  : "
  );

  Serial.print(
    noise,
    1
  );

  Serial.println(
    " / 100"
  );

  Serial.print(
    "Status       : "
  );

  Serial.println(
    status
  );

  Serial.print(
    "isNoisy      : "
  );

  Serial.println(
    isNoisy ?
    "true" :
    "false"
  );

  Serial.print(
    "Violation    : "
  );

  Serial.println(
    violation ?
    "true" :
    "false"
  );

  Serial.print(
    "ViolationCount: "
  );

  Serial.println(
    violationCount
  );

  // ===================================================
  // FIREBASE
  // ===================================================

  if (
    app.ready()
  )
  {
    Serial.println(
      "Firebase: Authentication READY"
    );

    unsigned long currentMillis =
      millis();

    if (
      currentMillis -
      lastFirebaseSend >=
      SEND_INTERVAL
    )
    {
      lastFirebaseSend =
        currentMillis;

      sendToFirebase(
        noise,
        status,
        isNoisy,
        violation,
        violationCount
      );
    }
  }
  else
  {
    Serial.println(
      "Firebase: Authentication not ready..."
    );
  }

  Serial.println(
    "--------------------------------------"
  );

  // Slow Serial output
  // but Firebase app.loop()
  // is still called frequently.

  delay(1000);
}
